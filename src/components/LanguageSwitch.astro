---
import { getDictionary, localizedPath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const dictionary = getDictionary(locale);
const targetLocale = locale === "en" ? "ja" : "en";
const targetPath = localizedPath(pathname, targetLocale);
---

<nav class="language-switch" aria-label="Language">
  <a
    href={locale === "en" ? pathname : localizedPath(pathname, "en")}
    aria-current={locale === "en" ? "page" : undefined}
    >{dictionary["language.english"]}</a
  >
  <span aria-hidden="true">·</span>
  <a href={targetPath} aria-current={locale === "ja" ? "page" : undefined}
    >{dictionary["language.japanese"]}</a
  >
</nav>

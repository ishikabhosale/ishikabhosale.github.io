---
import { ArrowUpRight } from "@lucide/astro";
import { SITE } from "../../config/site";
import { getDictionary, type Locale } from "../../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<section
  class="about-section section-frame"
  id="about"
  aria-labelledby="about-title"
>
  <div>
    <p class="section-index">05</p>
    <h2 id="about-title">{dictionary["about.heading"]}</h2>
  </div>
  <div class="about-copy">
    <p>{dictionary["about.body"]}</p>
    <div class="contact-links">
      <p>{dictionary["contact.heading"]}</p>
      <a href={SITE.social.github}
        >{dictionary["contact.github"]}<ArrowUpRight
          size={16}
          stroke-width="1.5"
          aria-hidden="true"
        /></a
      >
      <a href={SITE.social.linkedin}
        >{dictionary["contact.linkedin"]}<ArrowUpRight
          size={16}
          stroke-width="1.5"
          aria-hidden="true"
        /></a
      >
      {
        SITE.email && (
          <a href={`mailto:${SITE.email}`}>
            {dictionary["contact.email"]}
            <ArrowUpRight size={16} stroke-width="1.5" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</section>

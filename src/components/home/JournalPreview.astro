---
import { ArrowRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { getDictionary, type Locale } from "../../i18n/config";
import { estimateReadingMinutes } from "../../lib/content";
import { writingPath } from "../../lib/urls";

interface Props {
  locale: Locale;
  entries: CollectionEntry<"writing">[];
}

const { locale, entries } = Astro.props;
const dictionary = getDictionary(locale);
const dateLocale = locale === "ja" ? "ja-JP" : "en-US";
---

<section
  class="journal-section section-frame"
  id="writing"
  aria-labelledby="writing-title"
>
  <div class="journal-intro">
    <p class="section-index">04</p>
    <h2 id="writing-title">{dictionary["writing.heading"]}</h2>
    <a class="text-link" href={locale === "ja" ? "/ja/writing/" : "/writing/"}>
      {dictionary["writing.browse"]}
      <ArrowRight size={18} stroke-width="1.5" aria-hidden="true" />
    </a>
  </div>
  <div class="journal-list">
    {
      entries.slice(0, 3).map((entry, index) => (
        <a
          class={`journal-row journal-row-${index + 1}`}
          href={writingPath(entry.data.slug, locale)}
        >
          <div class="journal-meta">
            <time datetime={entry.data.publishedAt.toISOString()}>
              {entry.data.publishedAt.toLocaleDateString(dateLocale, {
                year: "numeric",
                month: "short",
                day: "2-digit",
              })}
            </time>
            <span>{entry.data.topic}</span>
          </div>
          <div class="journal-copy">
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
          </div>
          <span class="journal-time">
            {estimateReadingMinutes(entry.body ?? "")}{" "}
            {dictionary["writing.readTime"]}
          </span>
          <ArrowRight
            class="journal-arrow"
            size={18}
            stroke-width="1.5"
            aria-hidden="true"
          />
        </a>
      ))
    }
    {
      entries.length === 0 && (
        <p class="section-note">{dictionary["writing.empty"]}</p>
      )
    }
  </div>
</section>

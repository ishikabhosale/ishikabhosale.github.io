---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";
import { getDictionary, type Locale } from "../i18n/config";

interface Props {
  project: CollectionEntry<"projects">;
  locale: Locale;
  headings: { depth: number; slug: string; text: string }[];
}

const { project, locale, headings } = Astro.props;
const dictionary = getDictionary(locale);
const date = project.data.year?.toString();
---

<article class="project-page section-frame">
  <header class="project-header">
    <a class="back-link" href={locale === "ja" ? "/ja/work/" : "/work/"}>
      ← {dictionary["project.back"]}
    </a>
    <p class="eyebrow">{date ?? "Project"}</p>
    <h1>{project.data.title}</h1>
    <p class="project-description">{project.data.summary}</p>
    <div class="project-actions">
      {
        project.data.repositoryUrl && (
          <a
            class="button button-primary"
            href={project.data.repositoryUrl}
            target="_blank"
            rel="noreferrer"
          >
            {dictionary["project.repository"]}
            <ArrowUpRight size={17} stroke-width="1.5" aria-hidden="true" />
          </a>
        )
      }
      {
        project.data.demoUrl && (
          <a
            class="text-link"
            href={project.data.demoUrl}
            target="_blank"
            rel="noreferrer"
          >
            {dictionary["project.demo"]}
            <ArrowUpRight size={17} stroke-width="1.5" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </header>

  <div class="project-layout">
    <aside class="project-aside">
      <p class="section-index">{dictionary["project.technologies"]}</p>
      <ul class="tag-list">
        {project.data.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
      {
        headings.length > 0 && (
          <>
            <p class="section-index project-contents-label">
              {dictionary["article.contents"]}
            </p>
            <ol class="project-toc">
              {headings.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </>
        )
      }
    </aside>
    <div class="article-body project-body"><slot /></div>
  </div>

  <div class="project-footer-link">
    <a class="back-link" href={locale === "ja" ? "/ja/work/" : "/work/"}
      >← {dictionary["project.back"]}</a
    >
  </div>
</article>

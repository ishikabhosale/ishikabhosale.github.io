---
import { SITE } from "../config/site";
import type { Locale } from "../i18n/config";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  locale?: Locale;
  image?: string;
  article?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = "/",
  locale = "en",
  image = "/social-card.png",
  article = false,
} = Astro.props;
const pageTitle =
  title === SITE.title ? `${SITE.name} — ${title}` : `${title} — ${SITE.name}`;
const canonicalUrl = new URL(canonicalPath, SITE.url);
const imageUrl = new URL(image, SITE.url);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      let storedTheme = null;
      try {
        storedTheme = localStorage.getItem("portfolio-theme");
      } catch {
        storedTheme = null;
      }
      const systemTheme = window.matchMedia("(prefers-color-scheme: light)")
        .matches
        ? "light"
        : "dark";
      document.documentElement.dataset.theme =
        storedTheme === "light" || storedTheme === "dark"
          ? storedTheme
          : systemTheme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader locale={locale} pathname={pathname} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
